{
  "name": "@involvex/supercopy",
  "version": "0.0.12",
  "description": "A high-performance Windows file copy and unpack CLI with multi-threading, filters, dry-run, verify, and archive support.",
  "author": {
    "name": "Involvex"
  },
  "license": "MIT",
  "homepage": "https://github.com/involvex/supercopy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/involvex/supercopy.git"
  },
  "bugs": {
    "url": "https://github.com/involvex/supercopy/issues"
  },
  "engines": {
    "node": ">=14.0.0",
    "bun": ">=1.0.0"
  },
  "bin": {
    "supercopy": "bin/supercopy.js",
    "scpy": "bin/supercopy.js"
  },
  "scripts": {
    "start": "node bin/supercopy.js",
    "test": "python -m pytest tests -q",
    "build": "cmd /c build.bat --nopause",
    "build:cli": "cmd /c build.bat --cli --nopause",
    "release": "npm version patch && npm run build && node -e \"const v=require('./package.json').version; require('child_process').execSync('makensis /DVERSION='+v+' installer.nsi',{stdio:'inherit'})\" && npm publish --access public",
    "format": "bun fmt",
    "lint": "bun lint",
    "prebuild": "bun run lint && bun run format && bun check"
  },
  "os": [
    "win32"
  ],
  "cpu": [
    "x64",
    "ia32"
  ],
  "keywords": [
    "copy",
    "file-utility",
    "performance",
    "windows",
    "cli",
    "file-copy",
    "batch-processing",
    "file-management",
    "bun"
  ],
  "files": [
    "bin",
    "dist/SuperCopy.exe",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "preferGlobal": true,
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/involvex"
  },
  "publishConfig": {
    "access": "public"
  }
}
